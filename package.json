{
  "name": "legal-skill-studio",
  "version": "3.2.0",
  "private": true,
  "description": "法律 AI 平台的 Skill 与 Workflow 自助创建原型 v3.2（对话首页、运行过程实时日志与回放、DAG 工作流、多用户治理、版本钉住、数据保护、评测与受控自我优化；MVP 场景：新加坡营销物料合规初审）",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"tsx watch server/index.ts\" \"vite\"",
    "build": "vite build",
    "start": "vite build && tsx server/index.ts",
    "serve": "tsx server/index.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p .",
    "demo:real": "tsx scripts/demo-real.ts",
    "reset": "tsx scripts/reset-data.ts",
    "e2e": "vite build && node scripts/e2e-ui.cjs",
    "eval": "tsx scripts/eval.ts",
    "check:secrets": "tsx scripts/check-secrets.ts"
  },
  "dependencies": {
    "@tesseract.js-data/eng": "^1.0.0",
    "ajv": "^8.17.1",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "mammoth": "^1.13.0",
    "pdfjs-dist": "^6.4.299",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.0.1",
    "react-router-dom": "^6.28.0",
    "remark-gfm": "^4.0.0",
    "tesseract.js": "^7.0.0",
    "tsx": "^4.19.2",
    "yaml": "^2.6.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "docx": "^9.15.0",
    "pdf-lib": "^1.17.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "vitest": "^2.1.8"
  }
}
